<Window x:Class="Appmaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Appmaster.Views"
        Title="Appmaster" Width="1100" Height="680" MinWidth="760" MinHeight="460"
        Style="{StaticResource EwWindow}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Navigation im Kopf: aktiver Reiter mit Akzentlinie -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource EwTextMuted}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Padding="14,0" BorderThickness="0,2,0,2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource EwText}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource EwAccentLight}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource EwAccent}" />
                                <Setter TargetName="b" Property="BorderThickness" Value="0,2,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Statuspunkt: Farben sind Status-, nicht Kategoriefarben (rot = Fehler gilt überall) -->
        <Style x:Key="Punkt" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource EwTextFaint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ZustandName}" Value="Laeuft"><Setter Property="Fill" Value="{DynamicResource EwOk}" /></DataTrigger>
                <DataTrigger Binding="{Binding ZustandName}" Value="Gestoppt"><Setter Property="Fill" Value="{DynamicResource EwDanger}" /></DataTrigger>
                <DataTrigger Binding="{Binding ZustandName}" Value="Startet"><Setter Property="Fill" Value="{DynamicResource EwWarn}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Klein" TargetType="Button" BasedOn="{StaticResource EwButtonGhost}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="KleinHaupt" TargetType="Button" BasedOn="{StaticResource EwButtonPrimary}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="KleinGefahr" TargetType="Button" BasedOn="{StaticResource EwButtonDanger}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- Kompakte Knöpfe für die Karten im Raster -->
        <Style x:Key="Mini" TargetType="Button" BasedOn="{StaticResource EwButtonGhost}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,6" />
        </Style>
        <Style x:Key="MiniHaupt" TargetType="Button" BasedOn="{StaticResource EwButtonPrimary}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,6" />
        </Style>
        <Style x:Key="MiniGefahr" TargetType="Button" BasedOn="{StaticResource EwButtonDanger}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,6" />
        </Style>

        <!-- Sonne/Mond (Lucide, Strich 1,75) -->
        <Geometry x:Key="Sonne">M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z M12 2v2 M12 20v2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2 M6.34 17.66l-1.41 1.41 M19.07 4.93l-1.41 1.41</Geometry>
        <Geometry x:Key="Mond">M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z</Geometry>
        <Geometry x:Key="Info">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z M12 16v-4 M12 8h.01</Geometry>
        <Geometry x:Key="Plus">M12 5v14 M5 12h14</Geometry>
    </Window.Resources>

    <DockPanel>
        <!-- Kopf: App-Logo + Name, Navigation, rechts Aktionen -->
        <Border DockPanel.Dock="Top" Style="{StaticResource EwHeader}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <v:AppLogo Width="32" Height="32" />
                    <TextBlock Text="Appmaster" FontSize="17" FontWeight="SemiBold" Margin="12,0,28,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NeuKnopf" Style="{StaticResource KleinHaupt}" Click="Neu_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Plus}" Stroke="{DynamicResource EwTextOnAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock x:Name="NeuText" Text="App" Foreground="{DynamicResource EwTextOnAccent}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemaKnopf" Style="{StaticResource Klein}" Width="36" Padding="0" ToolTip="Helles oder dunkles Design" Click="Thema_Click">
                        <Path x:Name="ThemaIcon" Stroke="{DynamicResource EwTextMuted}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource Klein}" Content="Einstellungen" Click="Einstellungen_Click" />
                    <Button Style="{StaticResource Klein}" Content="Über" Click="Ueber_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Content="Apps" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavRessourcen" Style="{StaticResource Nav}" Content="Ressourcen" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavRechner" Style="{StaticResource Nav}" Content="Rechner" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Fuß: Eulenwerk-Marke -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource EwFooter}">
            <StackPanel x:Name="Fuss" Orientation="Horizontal" VerticalAlignment="Center" />
        </Border>

        <Grid>
            <!-- ===================== APPS ===================== -->
            <ScrollViewer x:Name="SeiteApps" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <DockPanel>
                        <Button x:Name="SucheKnopf" DockPanel.Dock="Right" Style="{StaticResource Klein}" VerticalAlignment="Center" Click="Suche_Click"
                                ToolTip="Sucht auf Arbeitsrechnern und Webservern nach Eulenwerk-Apps und legt sie automatisch an">Nach Eulenwerk-Apps suchen</Button>
                        <TextBlock Text="Meine Apps" Style="{StaticResource EwH2}" />
                    </DockPanel>
                    <TextBlock x:Name="SucheStatus" Style="{StaticResource EwMuted}" FontSize="12.5" Margin="0,0,0,6" Visibility="Collapsed" />
                    <TextBlock x:Name="LeerApps" Style="{StaticResource EwMuted}" Margin="0,0,0,12" Visibility="Collapsed" TextWrapping="Wrap"
                               Text="Noch keine Apps. Markiere unter „Rechner“ deinen PC als Arbeitsrechner und deinen Server als Webserver – Appmaster findet die Eulenwerk-Apps dann von selbst. Mit „+ App“ legst du andere Apps von Hand an." />
                    <ItemsControl x:Name="ListeApps">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource EwMuted}" FontWeight="SemiBold" Margin="2,14,0,8" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <!-- Karten innerhalb jeder Gruppe nebeneinander -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{DynamicResource KartenBreite}" MinHeight="168" Margin="0,0,12,12" Padding="0">
                                    <Border.Style>
                                        <!-- Eulenwerk-Apps: Rahmen in der Kategoriefarbe -->
                                        <Style TargetType="Border" BasedOn="{StaticResource EwCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IstEulenwerk}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{Binding KategoriePinsel}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Kategoriefarbe als Streifen -->
                                        <Border Background="{Binding KategoriePinsel}" CornerRadius="14,0,0,14" />
                                        <StackPanel Grid.Column="1" Margin="14,12,14,6">
                                            <DockPanel>
                                                <!-- App-Logo im Design-System-Stil: dunkle Kachel (rx 12), nur bei Eulenwerk-Apps -->
                                                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="11" Background="#1B1F20" Margin="0,0,12,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IstEulenwerk, Converter={StaticResource BoolZuSichtbar}}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold" Foreground="{Binding KategoriePinsel}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HatSymbol}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding Symbol}" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <WrapPanel Margin="0,2,0,0">
                                                        <Border CornerRadius="9" Padding="7,0" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{Binding KategoriePinsel}" VerticalAlignment="Center"
                                                                Visibility="{Binding IstEulenwerk, Converter={StaticResource BoolZuSichtbar}}">
                                                            <TextBlock Text="Eulenwerk" FontSize="11" FontWeight="SemiBold" Foreground="{Binding KategoriePinsel}" />
                                                        </Border>
                                                        <TextBlock Foreground="{DynamicResource EwTextFaint}" FontSize="12">
                                                            <Run Text="{Binding KategorieName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TypText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Beschreibung}" Style="{StaticResource EwMuted}" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="36" ToolTip="{Binding Beschreibung}" />
                                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource EwTextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RessourcenText}">
                                                <Run Text="Braucht: " /><Run Text="{Binding RessourcenText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource EwTextFaint}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IstEulenwerk}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding RechnerText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding VersionText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding StatusAnzeige}" Foreground="{DynamicResource EwAccentLight}" FontWeight="Medium" FontSize="12.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusAnzeige}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="Starten" IsEnabled="{Binding KannStarten}" Click="AppStart_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MiniHaupt}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Laeuft}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Beenden" IsEnabled="{Binding KannBeenden}" Click="AppEnde_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MiniGefahr}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Laeuft}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Bearbeiten" Style="{StaticResource Mini}" Click="AppBearbeiten_Click" />
                                                <Button Content="Entfernen" Style="{StaticResource Mini}" Click="AppEntfernen_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== RESSOURCEN ===================== -->
            <ScrollViewer x:Name="SeiteRessourcen" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,20">
                    <TextBlock Text="Ressourcen" Style="{StaticResource EwH2}" />
                    <TextBlock Style="{StaticResource EwMuted}" Margin="0,0,0,14"
                               Text="Alles, was deine Apps brauchen: KI-Dienste auf Athene oder dem PC, Datenbanken, Container. Appmaster prüft laufend, ob sie antworten." />
                    <TextBlock x:Name="LeerRessourcen" Style="{StaticResource EwMuted}" Margin="0,0,0,12" Visibility="Collapsed"
                               Text="Noch keine Ressourcen. Lege zuerst einen Rechner an, dann hier die Dienste darauf." />
                    <ItemsControl x:Name="ListeRessourcen">
                        <!-- Nach Rechner getrennt, mit Überschrift -->
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource EwMuted}" FontWeight="SemiBold" Margin="2,14,0,8" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EwCard}" Width="{DynamicResource KartenBreite}" MinHeight="104" Margin="0,0,12,12" Padding="14,12,14,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource Punkt}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource EwMuted}" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap">
                                            <Run Text="{Binding ZustandText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding NutzerText, Mode=OneWay}" />
                                        </TextBlock>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Starten" Style="{StaticResource MiniHaupt}" IsEnabled="{Binding KannStarten}" Click="RessStart_Click"
                                                    Visibility="{Binding KannSteuern, Converter={StaticResource BoolZuSichtbar}}" />
                                            <Button Content="Stoppen" Style="{StaticResource Mini}" IsEnabled="{Binding KannStoppen}" Click="RessStopp_Click"
                                                    Visibility="{Binding KannSteuern, Converter={StaticResource BoolZuSichtbar}}" />
                                            <Button Content="Bearbeiten" Style="{StaticResource Mini}" Click="RessBearbeiten_Click" />
                                            <Button Content="Entfernen" Style="{StaticResource Mini}" Click="RessEntfernen_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== RECHNER ===================== -->
            <ScrollViewer x:Name="SeiteRechner" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,20">
                    <TextBlock Text="Rechner" Style="{StaticResource EwH2}" />
                    <TextBlock Style="{StaticResource EwMuted}" Margin="0,0,0,14"
                               Text="Die Maschinen, auf denen Ressourcen laufen (Athene, GPU-PC, Server). Leere Adresse = dieser PC. Mit MAC-Adresse lässt sich ein Rechner per Wake-on-LAN aufwecken, mit Agent zeigt Appmaster Leistungsdaten und steuert Docker." />
                    <TextBlock x:Name="LeerRechner" Style="{StaticResource EwMuted}" Margin="0,0,0,12" Visibility="Collapsed"
                               Text="Noch keine Rechner. Mit „+ Rechner“ legst du z. B. Athene an." />
                    <ItemsControl x:Name="ListeRechner">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EwCard}" Margin="0,0,0,10" Padding="18,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Style="{StaticResource Punkt}" Margin="0,0,14,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Adresse}" Foreground="{DynamicResource EwTextFaint}" Margin="10,2,0,0" FontSize="12.5" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource EwMuted}" Margin="0,2,0,0" FontSize="12.5">
                                                <Run Text="{Binding ZustandText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding KategorienText}" Margin="0,2,0,0" FontSize="12.5" Foreground="{DynamicResource EwAccentLight}"
                                                       Visibility="{Binding HatKategorien, Converter={StaticResource BoolZuSichtbar}}" />
                                            <TextBlock Text="{Binding Hinweis}" Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource EwWarn}"
                                                       Visibility="{Binding HatHinweis, Converter={StaticResource BoolZuSichtbar}}" />
                                            <TextBlock Text="{Binding Meldung}" Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource EwAccentLight}"
                                                       Visibility="{Binding HatMeldung, Converter={StaticResource BoolZuSichtbar}}" />
                                            <!-- Messwerte vom Agent -->
                                            <Grid Margin="0,10,0,0" Visibility="{Binding HatMessdaten, Converter={StaticResource BoolZuSichtbar}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding CpuText}" FontSize="12.5" Style="{StaticResource EwMuted}" />
                                                    <ProgressBar Value="{Binding CpuProzent, Mode=OneWay}" Maximum="100" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding RamText}" FontSize="12.5" Style="{StaticResource EwMuted}" />
                                                    <ProgressBar Value="{Binding RamProzent, Mode=OneWay}" Maximum="100" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Visibility="{Binding HatGpu, Converter={StaticResource BoolZuSichtbar}}">
                                                    <TextBlock Text="{Binding GpuText}" FontSize="12.5" Style="{StaticResource EwMuted}" />
                                                    <ProgressBar Value="{Binding GpuProzent, Mode=OneWay}" Maximum="100" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding InfoText}" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource EwTextFaint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Aufwecken" Style="{StaticResource KleinHaupt}" IsEnabled="{Binding KannAufwecken}" Click="RechAufwecken_Click" />
                                            <Button Content="Herunterfahren" Style="{StaticResource Klein}" IsEnabled="{Binding KannHerunterfahren}" Click="RechAus_Click" />
                                            <Button Content="Bearbeiten" Style="{StaticResource Klein}" Click="RechBearbeiten_Click" />
                                            <Button Content="Entfernen" Style="{StaticResource Klein}" Click="RechEntfernen_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Agent für Linux-Server / Webhosting installieren …" Style="{StaticResource Klein}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="AgentHilfe_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
