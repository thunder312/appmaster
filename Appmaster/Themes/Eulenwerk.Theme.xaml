<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Eulenwerk Design-System · WPF-Theme (Standard dunkel, optional hell über EulenwerkTheme.cs). Einbindung in App.xaml:
       <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
         <ResourceDictionary Source="Themes/Eulenwerk.Kreativ.xaml"/>   ← Kategorie
         <ResourceDictionary Source="Themes/Eulenwerk.Theme.xaml"/>
       </ResourceDictionary.MergedDictionaries></ResourceDictionary></Application.Resources>
       Die Akzent-Keys (EwAccent, EwAccentHover, EwAccentSoft, EwAccentLight, EwFontHeading) kommen aus dem Kategorie-Dictionary. -->

  <Color x:Key="EwBgColor">#121417</Color>
  <SolidColorBrush x:Key="EwBg" Color="{StaticResource EwBgColor}" />
  <Color x:Key="EwSurfaceColor">#181B1F</Color>
  <SolidColorBrush x:Key="EwSurface" Color="{StaticResource EwSurfaceColor}" />
  <Color x:Key="EwSurface2Color">#1F2328</Color>
  <SolidColorBrush x:Key="EwSurface2" Color="{StaticResource EwSurface2Color}" />
  <Color x:Key="EwSurfaceHoverColor">#242930</Color>
  <SolidColorBrush x:Key="EwSurfaceHover" Color="{StaticResource EwSurfaceHoverColor}" />
  <Color x:Key="EwBorderColor">#2A2F36</Color>
  <SolidColorBrush x:Key="EwBorder" Color="{StaticResource EwBorderColor}" />
  <Color x:Key="EwBorderStrongColor">#3A4049</Color>
  <SolidColorBrush x:Key="EwBorderStrong" Color="{StaticResource EwBorderStrongColor}" />
  <Color x:Key="EwTextColor">#E7E9EC</Color>
  <SolidColorBrush x:Key="EwText" Color="{StaticResource EwTextColor}" />
  <Color x:Key="EwTextMutedColor">#9AA3AD</Color>
  <SolidColorBrush x:Key="EwTextMuted" Color="{StaticResource EwTextMutedColor}" />
  <Color x:Key="EwTextFaintColor">#6B7480</Color>
  <SolidColorBrush x:Key="EwTextFaint" Color="{StaticResource EwTextFaintColor}" />
  <Color x:Key="EwTextOnAccentColor">#0F1115</Color>
  <SolidColorBrush x:Key="EwTextOnAccent" Color="{StaticResource EwTextOnAccentColor}" />
  <Color x:Key="EwOkColor">#3ECF8E</Color>
  <SolidColorBrush x:Key="EwOk" Color="{StaticResource EwOkColor}" />
  <Color x:Key="EwWarnColor">#F0B429</Color>
  <SolidColorBrush x:Key="EwWarn" Color="{StaticResource EwWarnColor}" />
  <Color x:Key="EwDangerColor">#F26D6D</Color>
  <SolidColorBrush x:Key="EwDanger" Color="{StaticResource EwDangerColor}" />
  <Color x:Key="EwInfoColor">#5B8DEF</Color>
  <SolidColorBrush x:Key="EwInfo" Color="{StaticResource EwInfoColor}" />
  <Color x:Key="EwInputBgColor">#121417</Color>
  <SolidColorBrush x:Key="EwInputBg" Color="{StaticResource EwInputBgColor}" />

  <FontFamily x:Key="EwFontSans">Inter, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="EwFontMono">Cascadia Code, Consolas, monospace</FontFamily>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="EwTextSize">14</sys:Double>
  <CornerRadius x:Key="EwRadiusSm">6</CornerRadius>
  <CornerRadius x:Key="EwRadius">10</CornerRadius>
  <CornerRadius x:Key="EwRadiusLg">14</CornerRadius>

  <!-- Fenster -->
  <Style x:Key="EwWindow" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource EwBg}" />
    <Setter Property="Foreground" Value="{DynamicResource EwText}" />
    <Setter Property="FontFamily" Value="{StaticResource EwFontSans}" />
    <Setter Property="FontSize" Value="{StaticResource EwTextSize}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- Text -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource EwText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="EwH1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource EwFontHeading}" />
    <Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="EwH2" TargetType="TextBlock" BasedOn="{StaticResource EwH1}"><Setter Property="FontSize" Value="20" /></Style>
  <Style x:Key="EwH3" TargetType="TextBlock" BasedOn="{StaticResource EwH1}"><Setter Property="FontSize" Value="16" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
  <Style x:Key="EwMuted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource EwTextMuted}" /></Style>
  <Style x:Key="EwLabel" TargetType="TextBlock" BasedOn="{StaticResource EwMuted}"><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Margin" Value="0,0,0,6" /></Style>

  <!-- Buttons -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource EwSurface2}" />
    <Setter Property="Foreground" Value="{DynamicResource EwText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EwBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource EwRadiusSm}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource EwSurfaceHover}" /><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource EwTextFaint}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="EwButtonPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource EwAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EwAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource EwTextOnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource EwRadiusSm}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource EwAccentHover}" /><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource EwAccentHover}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="EwButtonGhost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource EwTextMuted}" />
  </Style>
  <Style x:Key="EwButtonDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource EwDanger}" /><Setter Property="Foreground" Value="{DynamicResource EwDanger}" />
  </Style>

  <!-- Eingaben -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource EwInputBg}" />
    <Setter Property="Foreground" Value="{DynamicResource EwText}" />
    <Setter Property="CaretBrush" Value="{DynamicResource EwText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EwBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource EwAccentSoft}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource EwRadiusSm}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource EwTextFaint}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource EwAccent}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Dropdowns: dunkles Popup (EwSurface2) mit hellem Text, Auswahl in Akzent – wie .ew-select im eulenwerk.css -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource EwText}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource EwSurfaceHover}" /></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource EwAccentSoft}" />
              <Setter Property="Foreground" Value="{DynamicResource EwAccentLight}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource EwInputBg}" />
    <Setter Property="Foreground" Value="{DynamicResource EwText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EwBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" Background="{DynamicResource EwInputBg}" BorderBrush="{DynamicResource EwBorderStrong}"
                          BorderThickness="1" CornerRadius="{StaticResource EwRadiusSm}">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L5,5 L10,0"
                          Stroke="{DynamicResource EwTextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EwTextFaint}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EwAccent}" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="10,6,32,6" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Margin="0,4,0,8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource EwSurface2}"
                      BorderBrush="{DynamicResource EwAccent}" BorderThickness="1" CornerRadius="{StaticResource EwRadiusSm}" Padding="4">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" /></Border.Effect>
                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource EwText}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource EwTextMuted}" /><Setter Property="Padding" Value="0,0,0,4" /></Style>

  <!-- Flächen -->
  <Style x:Key="EwCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource EwSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EwBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource EwRadiusLg}" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style x:Key="EwHeader" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource EwSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EwBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Height" Value="52" />
  </Style>
  <Style x:Key="EwFooter" TargetType="Border" BasedOn="{StaticResource EwHeader}">
    <Setter Property="BorderThickness" Value="0,1,0,0" /><Setter Property="Height" Value="40" /><Setter Property="Background" Value="{DynamicResource EwBg}" />
  </Style>
  <Style TargetType="Separator"><Setter Property="Background" Value="{DynamicResource EwBorder}" /><Setter Property="Margin" Value="0,12" /></Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="6" /><Setter Property="Background" Value="{DynamicResource EwBorder}" /><Setter Property="Foreground" Value="{DynamicResource EwAccent}" /><Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Tabs -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0,16,0,0" />
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource EwTextMuted}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource EwText}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource EwAccentLight}" /><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource EwAccent}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Eulenwerk-Eule als Pfad (64er-Raster, Strich 4) – Fill/Stroke auf Akzent setzen -->
  <Geometry x:Key="EwOwlStrokeGeometry">M8 5 C11 12 16 13 24 13 C28 13 30 15 32 16 C34 15 36 13 40 13 C48 13 53 12 56 5 M13 28 V48 C13 54 18 59 24 59 H40 C46 59 51 54 51 48 V28 M19 40 C18.5 48 19.5 54 23 59 M45 40 C45.5 48 44.5 54 41 59 M29.5 39 L32 42.5 L34.5 39 M31 28 A9 9 0 1 1 13 28 A9 9 0 1 1 31 28 M51 28 A9 9 0 1 1 33 28 A9 9 0 1 1 51 28</Geometry>
  <Geometry x:Key="EwOwlFillGeometry">M25.2 28 A3.2 3.2 0 1 1 18.8 28 A3.2 3.2 0 1 1 25.2 28 M45.2 28 A3.2 3.2 0 1 1 38.8 28 A3.2 3.2 0 1 1 45.2 28</Geometry>
  <DataTemplate x:Key="EwOwlIcon">
    <Viewbox Width="28" Height="28">
      <Canvas Width="64" Height="64">
        <Path Data="{StaticResource EwOwlStrokeGeometry}" Stroke="{DynamicResource EwAccent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        <Path Data="{StaticResource EwOwlFillGeometry}" Fill="{DynamicResource EwAccent}" />
      </Canvas>
    </Viewbox>
  </DataTemplate>
</ResourceDictionary>
